{
  "scripts": {
    "prepare": "husky",
    "format": "npm run format:files && npm run format:terraform",
    "format:files": "prettier --write .",
    "format:terraform": "terraform fmt -recursive -write",
    "generate-module-documentation": "./scripts/generate-module-documentation.sh",
    "lint": "npm run lint:files && npm run lint:terraform && npm run lint:tflint",
    "lint:ci": "npm run lint:files",
    "lint:files": "prettier --check .",
    "lint:terraform": "terraform fmt -recursive -check -diff",
    "lint:tflint": "tflint --init && tflint --recursive"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@engineering/npm-dev-tools": "^1.0.0",
    "@semantic-release/gitlab": "^13.0.3",
    "husky": "^9.0.11",
    "prettier": "^3.2.5",
    "semantic-release": "^23.0.5"
  }
}
